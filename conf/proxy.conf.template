# Traefik termine le TLS et parle toujours en clair au conteneur en aval : $scheme
# vaut donc systématiquement "http" ici, même pour une requête HTTPS côté client.
# On fait suivre tel quel le header déjà positionné par Traefik (avec repli sur les
# valeurs locales si le service est atteint directement, hors Traefik).
map $http_x_forwarded_proto $proxy_x_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_x_forwarded_host $proxy_x_forwarded_host {
    default $http_x_forwarded_host;
    ''      $host;
}

map $http_x_forwarded_port $proxy_x_forwarded_port {
    default $http_x_forwarded_port;
    ''      $server_port;
}

# Permet de faire suivre les upgrades de protocole (WebSocket) : Connection passe
# à "upgrade" si le client demande un Upgrade, "close" sinon (comportement nginx standard).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${PORT};

    # Failover ne doit jamais être le facteur limitant côté taille de requête :
    # pas de 413, quelle que soit la taille de l'upload (l'upstream reste seul juge).
    client_max_body_size 0;

    location / {
        proxy_pass http://${UPSTREAM_HOST}:${UPSTREAM_PORT};

        # HTTP/1.1 vers l'upstream : requis pour le keep-alive et les upgrades
        # de protocole (WebSocket), impossibles en HTTP/1.0.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Pas de mise en buffer : laisse passer les réponses en streaming (SSE,
        # chunked...) et les corps de requête volumineux sans les accumuler en
        # mémoire/disque avant de les transmettre.
        proxy_buffering off;
        proxy_request_buffering off;

        # Pas de coupure sur les connexions longues (WebSocket, SSE, upload/download lents).
        # Note : "0" n'est PAS un délai infini pour ces directives (contrairement à
        # keepalive_timeout 0), c'est un timeout immédiat — on met donc une valeur haute.
        proxy_connect_timeout 60s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $proxy_x_forwarded_proto;
        proxy_set_header X-Forwarded-Host $proxy_x_forwarded_host;
        proxy_set_header X-Forwarded-Port $proxy_x_forwarded_port;
        proxy_set_header X-Forwarded-Prefix $http_x_forwarded_prefix;
    }
}
